#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "open3"
require "optparse"
require "tempfile"

# Uploads freshly built rubies to the rv.dev/ruby bucket.
#
#   tools/publish build --bucket=rv-ruby --date=20261014 DIR     print the build id for the tarballs in DIR
#   tools/publish upload --bucket=rv-ruby --build=20261014 DIR   upload them under that build id
#   tools/publish release-sums SHA256SUMS                        print a checksum file from the bucket
#                                                                with the names the tarballs were built with
#
# A tarball goes to {version}/{build}/{filename}, followed by a .sha256 sidecar. Its
# filename there names the platform the way rv does, like macos-aarch64, where the
# tarball as built has a Homebrew bottle tag, like arm64_sonoma.
# The build id is the date, with -2, -3 and so on when that date is taken, so
# nothing in the bucket is ever overwritten. A tarball that is the same as its
# newest build in the bucket is left out, so running a release again only
# uploads what the first run didn't.
module Publish
  # What a platform is called in the name of a tarball as built, and in the bucket.
  PLATFORMS = {
    "arm64_sonoma"      => "macos-aarch64",
    "ventura"           => "macos-x86_64",
    "x86_64_linux"      => "linux-x86_64",
    "arm64_linux"       => "linux-aarch64",
    "x86_64_linux_musl" => "linux-musl-x86_64",
    "arm64_linux_musl"  => "linux-musl-aarch64",
  }.freeze
  # ruby-3.4.13.arm64_sonoma.tar.gz, or ruby-4.0.9.arm64_sonoma.asan_ubsan.tar.gz for a variant.
  # Platform names never start with a digit, which is where the version ends.
  VERSION = /dev|\d[^.]*(?:\.\d[^.]*)*/
  VARIANT = /(?:\.\w+)*\.tar\.gz/
  BUILT = /\Aruby-(?<version>#{VERSION})\.(?<platform>#{PLATFORMS.keys.join("|")})(?<variant>#{VARIANT})\z/
  PUBLISHED = /\Aruby-(?<version>#{VERSION})\.(?<platform>#{PLATFORMS.values.join("|")})(?<variant>#{VARIANT})\z/

  module_function

  def run(argv, out: $stdout)
    options = {}
    parser = OptionParser.new do |opts|
      opts.banner = "Usage: publish build|upload [options] DIR, or publish release-sums FILE"
      opts.on("--bucket=NAME", "bucket to publish to")
      opts.on("--date=YYYYMMDD", "with build, the date the build id starts from")
      opts.on("--build=ID", "with upload, the build id to upload under")
    end
    command, dir = parser.parse(argv, into: options)
    return out.puts release_sums(File.read(dir)) if command == "release-sums" && dir

    tarballs = Dir.glob("*.tar.gz", base: dir.to_s).sort
    abort parser.help if options[:bucket].nil? || tarballs.empty?

    case command
    when "build"
      out.puts build_id(options.fetch(:date), tarballs, keys(options[:bucket]))
    when "upload"
      keys = keys(options[:bucket])
      tarballs.each do |filename|
        path = File.join(dir, filename)
        key = key(filename, options.fetch(:build))
        next if published?(options[:bucket], path, newest(key, keys))

        upload(options[:bucket], path, key)
        out.puts key
      end
    else
      abort parser.help
    end
  end

  def aws(*args)
    output, status = Open3.capture2("aws", *args)
    abort "aws #{args.join(" ")} failed" unless status.success?

    output
  end

  def keys(bucket)
    aws("s3api", "list-objects-v2", "--bucket", bucket, "--output", "text", "--query", "Contents[].[Key]").split("\n")
  end

  def key(filename, build)
    built = BUILT.match(filename)
    abort "#{filename} is not a ruby for a platform we publish" if built.nil?

    "#{built[:version]}/#{build}/ruby-#{built[:version]}.#{PLATFORMS.fetch(built[:platform])}#{built[:variant]}"
  end

  # The GitHub release that older versions of rv install from keeps the names the tarballs
  # were built with. This rewrites a checksum file from the bucket to match, leaving out
  # what isn't in that release: the rubies we mirror, and dev.
  def release_sums(sums)
    sums.each_line.filter_map do |line|
      sha256, filename = line.split
      published = PUBLISHED.match(filename)
      next if published.nil? || published[:version] == "dev"

      "#{sha256}  ruby-#{published[:version]}.#{PLATFORMS.key(published[:platform])}#{published[:variant]}\n"
    end.join
  end

  def build_id(date, filenames, keys)
    builds = (1..).lazy.map { |n| (n == 1) ? date : "#{date}-#{n}" }
    builds.find { |build| filenames.none? { |filename| keys.include?(key(filename, build)) } }
  end

  # The newest build of a tarball that finished uploading, which is the one the index lists.
  def newest(key, keys)
    version, _, filename = key.split("/")
    builds = keys.select do |published|
      published.start_with?("#{version}/") && published.end_with?("/#{filename}") &&
        keys.include?("#{published}.sha256")
    end
    builds.max_by do |published|
      date, ordinal = published.split("/")[1].split("-")
      [date, ordinal.to_i]
    end
  end

  def published?(bucket, path, newest)
    return false if newest.nil?

    aws("s3", "cp", "s3://#{bucket}/#{newest}.sha256", "-").split.first == Digest::SHA256.file(path).hexdigest
  end

  # The sidecar goes up last: tools/index only lists a tarball that has one.
  def upload(bucket, path, key)
    aws("s3", "cp", path, "s3://#{bucket}/#{key}", "--only-show-errors")

    Tempfile.create("sha256") do |sidecar|
      sidecar.write("#{Digest::SHA256.file(path).hexdigest}  #{File.basename(key)}\n")
      sidecar.close
      aws("s3", "cp", sidecar.path, "s3://#{bucket}/#{key}.sha256", "--only-show-errors",
          "--content-type", "text/plain")
    end
  end
end

Publish.run(ARGV) if $PROGRAM_NAME == __FILE__
