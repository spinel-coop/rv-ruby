#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "open3"
require "optparse"
require "time"
require "tmpdir"

# Generates the rv.dev/ruby index from the objects in the bucket.
#
#   tools/index --bucket=rv-ruby --out=DIR
#
# Writes v1/index.json, v1/SHA256SUMS and an alias/{engine}/{version}.json for each
# version into DIR, laid out like the bucket, then prints the surrogate keys to
# purge once DIR is uploaded. The bucket is only read, never written.
module Index
  BASE_URL = "https://rv.dev/ruby"
  ENGINES = %w[ruby jruby].freeze
  UNIX = %w[
    macos-aarch64 macos-x86_64 linux-x86_64 linux-aarch64 linux-musl-x86_64 linux-musl-aarch64
  ].freeze
  # What RubyInstaller2 calls each Windows platform in a filename, and the name rv knows it by.
  WINDOWS = { "x64" => "windows-x86_64", "arm" => "windows-aarch64" }.freeze
  PLATFORMS = (UNIX + WINDOWS.values).freeze

  # Our own builds, one for each platform, which tools/publish names for it.
  RUBY = %r{
    \A(?<version>[^/]+)/(?<build>[^/]+)/
    (?<filename>ruby-\k<version>\.(?<platform>#{UNIX.join("|")})\.tar\.gz)\z
  }x
  # RubyInstaller2's builds for Windows, which tools/mirror copies. Their build of Ruby's
  # master branch is called head, and is our dev.
  RUBYINSTALLER = %r{
    \A(?<version>[^/]+)/(?<build>[^/]+)/
    (?<filename>rubyinstaller-(?<release>\k<version>-\d+|head)-(?<platform>#{WINDOWS.keys.join("|")})\.7z)\z
  }x
  # JRuby's own archives, also mirrored. The tarball runs anywhere but Windows, which gets the zip.
  JRUBY = %r{
    \Ajruby/(?<version>[^/]+)/(?<build>[^/]+)/
    (?<filename>jruby-bin-\k<version>\.(?<extension>tar\.gz|zip))\z
  }x

  module_function

  def run(argv, out: $stdout)
    options = {}
    parser = OptionParser.new do |opts|
      opts.banner = "Usage: index --bucket=NAME --out=DIR"
      opts.on("--bucket=NAME", "bucket to read")
      opts.on("--out=DIR", "directory to write the index into")
    end
    parser.parse(argv, into: options)
    abort parser.help if options[:bucket].nil? || options[:out].nil?

    Dir.mktmpdir do |current|
      objects = list(options[:bucket])
      aws("s3", "sync", "s3://#{options[:bucket]}", current, "--only-show-errors",
          "--exclude", "*", "--include", "*.sha256", "--include", "alias/*", "--include", "v1/index.json")
      sidecars = Dir.glob("**/*.sha256", base: current).to_h { |key| [key, File.read(File.join(current, key))] }
      published = File.join(current, "v1/index.json")
      previous = File.exist?(published) ? JSON.parse(File.read(published), symbolize_names: true)[:rubies] : []

      entries = with_upstream(newest(artifacts(objects, sidecars)), previous) do |entry|
        upstream(options[:bucket], entry[:url].delete_prefix("#{BASE_URL}/"))
      end
      files = files(entries, Time.now.utc)
      files.each do |key, content|
        path = File.join(options[:out], key)
        FileUtils.mkdir_p(File.dirname(path))
        File.write(path, content)
      end

      changed = files.keys.select do |key|
        published = File.join(current, key)
        key.start_with?("alias/") && !(File.exist?(published) && File.read(published) == files[key])
      end
      out.puts JSON.generate(["index", *changed.map { |key| surrogate_key(key) }])
    end
  end

  def aws(*args)
    output, status = Open3.capture2("aws", *args)
    abort "aws #{args.join(" ")} failed" unless status.success?

    output
  end

  def list(bucket)
    query = "Contents[].{key: Key, size: Size, modified: LastModified}"
    listing = aws("s3api", "list-objects-v2", "--bucket", bucket, "--output", "json", "--query", query)
    JSON.parse(listing, symbolize_names: true) || []
  end

  # An object is an artifact once its .sha256 sidecar exists, which is uploaded after it.
  # Sanitizer builds are in the bucket too, but their names don't match and they stay unlisted.
  def artifacts(objects, sidecars)
    objects.filter_map do |object|
      archive = identify(object[:key])
      sidecar = sidecars["#{object[:key]}.sha256"]
      next if archive.nil? || sidecar.nil?

      archive.merge(
        url:      "#{BASE_URL}/#{object[:key]}",
        size:     object[:size],
        sha256:   sidecar.split.first,
        modified: object[:modified],
      )
    end
  end

  def identify(key)
    if (match = RUBY.match(key))
      archive(match, "ruby", [match[:platform]])
    elsif (match = RUBYINSTALLER.match(key)) && (match[:version] == "dev") == (match[:release] == "head")
      archive(match, "ruby", [WINDOWS.fetch(match[:platform])], mirrored: true)
    elsif (match = JRUBY.match(key))
      archive(match, "jruby", (match[:extension] == "zip") ? WINDOWS.values : UNIX, mirrored: true)
    end
  end

  def archive(match, engine, platforms, mirrored: false)
    {
      engine:    engine,
      version:   match[:version],
      build:     match[:build],
      platforms: platforms,
      filename:  match[:filename],
      mirrored:  mirrored,
    }
  end

  def newest(artifacts)
    newest = artifacts.group_by { |artifact| artifact.values_at(:engine, :version, :platforms) }
                      .map { |_, builds| builds.max_by { |artifact| build_order(artifact) } }
    newest.sort_by do |artifact|
      engine, version, platforms = artifact.values_at(:engine, :version, :platforms)
      [ENGINES.index(engine), version_order(version), PLATFORMS.index(platforms.first)]
    end
  end

  # Where a mirrored archive came from is kept in its metadata, and asked for with the block.
  # It never changes, so what the previous index said about an archive is used again.
  def with_upstream(entries, previous)
    known = previous.to_h { |ruby| [ruby[:url], ruby[:upstream]] }

    entries.map do |entry|
      entry[:mirrored] ? entry.merge(upstream: known[entry[:url]] || yield(entry)) : entry
    end
  end

  def upstream(bucket, key)
    metadata = JSON.parse(aws("s3api", "head-object", "--bucket", bucket, "--key", key, "--output", "json",
                              "--query", "Metadata"))
    {
      url:         metadata.fetch("upstream-url"),
      sha256:      metadata.fetch("upstream-sha256"),
      released_at: metadata.fetch("upstream-released-at"),
    }
  end

  # Builds are dated, and a later build on the same day carries a suffix, like 20261014-2.
  # A mirrored archive counts up with a dot instead, like 20261018.2.
  def build_order(artifact)
    date, suffix = artifact[:build].split(/[-.]/, 2)
    [date, suffix.to_i, artifact[:modified]]
  end

  # "dev" isn't a version, and sorts after everything that is.
  def version_order(version)
    Gem::Version.correct?(version) ? [0, Gem::Version.new(version)] : [1, version]
  end

  def files(entries, now)
    files = {
      "v1/index.json" => "#{JSON.generate(index(entries, now))}\n",
      "v1/SHA256SUMS" => sums(entries),
    }
    entries.group_by { |entry| entry.values_at(:engine, :version) }.each do |(engine, version), versions|
      files["alias/#{engine}/#{version}.json"] = "#{JSON.generate(alias_map(engine, version, versions))}\n"
    end
    files
  end

  def index(entries, now)
    {
      schema:       1,
      generated_at: now.iso8601,
      rubies:       entries.map { |entry| entry.except(:modified, :mirrored) },
    }
  end

  def alias_map(engine, version, entries)
    platforms = entries.flat_map do |entry|
      entry[:platforms].map { |platform| [platform, entry.slice(:build, :filename, :url, :size, :sha256)] }
    end
    { engine: engine, version: version, platforms: platforms.to_h }
  end

  def sums(entries)
    entries.sort_by { |entry| entry[:filename] }.map { |entry| "#{entry[:sha256]}  #{entry[:filename]}\n" }.join
  end

  def surrogate_key(alias_key)
    alias_key.delete_suffix(".json").tr("/", ":")
  end
end

Index.run(ARGV) if $PROGRAM_NAME == __FILE__
